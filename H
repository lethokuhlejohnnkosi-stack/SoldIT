<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Soldit - Buy, Sell & Live Stream Locally</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#eef2ff',
                            100: '#e0e7ff',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                            900: '#312e81',
                        }
                    },
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-slate-950 text-slate-100 font-sans antialiased selection:bg-indigo-500 selection:text-white">

    <!-- NAVIGATION BAR -->
    <nav class="sticky top-0 z-40 bg-slate-950/80 backdrop-blur-lg border-b border-slate-800/80">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 to-violet-500 flex items-center justify-center font-black text-xl text-white shadow-lg shadow-indigo-500/30">
                    S
                </div>
                <span class="text-2xl font-extrabold tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-white via-slate-200 to-indigo-400">Soldit</span>
            </div>

            <div class="hidden md:flex items-center space-x-8 text-sm font-semibold text-slate-300">
                <a href="#reels" class="hover:text-white transition">Reels</a>
                <a href="#live" class="hover:text-white transition">Live Streams</a>
                <a href="#calculator" class="hover:text-white transition">Earnings Calculator</a>
                <a href="#marketplace" class="hover:text-white transition">Marketplace</a>
            </div>

            <div class="flex items-center space-x-4">
                <div id="userProfileBtn" class="hidden flex items-center space-x-3 bg-slate-900 border border-slate-800 px-4 py-2 rounded-xl">
                    <span id="navUserName" class="text-sm font-bold text-indigo-400"></span>
                    <button onclick="handleLogout()" class="text-xs text-slate-400 hover:text-red-400 transition font-semibold">Logout</button>
                </div>

                <button id="navAuthBtn" onclick="toggleAuthModal()" class="bg-indigo-600 hover:bg-indigo-500 text-white font-bold px-5 py-2.5 rounded-xl shadow-lg shadow-indigo-600/30 transition">
                    Sign Up / Log In
                </button>
            </div>
        </div>
    </nav>

    <!-- HERO SECTION -->
    <section class="relative pt-12 pb-20 md:py-32 overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="text-center max-w-3xl mx-auto space-y-6">
                <div class="inline-flex items-center space-x-2 bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide uppercase">
                    <span class="w-2 h-2 rounded-full bg-indigo-400 animate-ping"></span>
                    <span>Live Local P2P Marketplace</span>
                </div>
                <h1 class="text-4xl sm:text-6xl font-black text-white tracking-tight leading-tight">
                    Buy & Sell with <span class="bg-clip-text text-transparent bg-gradient-to-r from-indigo-400 via-violet-400 to-pink-400">Real-Time Video</span>
                </h1>
                <p class="text-lg text-slate-400 font-normal">
                    Discover neighborhood deals through TikTok-style video reels, interactive live auctions, and safe local trades powered by verified PayPal payouts.
                </p>
                <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
                    <button onclick="toggleAuthModal()" class="w-full sm:w-auto bg-indigo-600 hover:bg-indigo-500 text-white font-bold px-8 py-4 rounded-2xl shadow-xl shadow-indigo-600/30 transition text-base">
                        Start Selling Now
                    </button>
                    <a href="#marketplace" class="w-full sm:w-auto bg-slate-900 border border-slate-800 hover:bg-slate-800 text-slate-300 font-bold px-8 py-4 rounded-2xl transition text-base text-center">
                        Explore Deals
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- MARKETPLACE FEED -->
    <section id="marketplace" class="py-20 bg-slate-900/50 border-t border-slate-800/80">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-10">
                <div>
                    <h2 class="text-3xl font-bold text-white tracking-tight">Recent Local Listings</h2>
                    <p class="text-slate-400 text-sm mt-1">Verified local sellers with zero listing platform fees</p>
                </div>
                <div class="flex items-center space-x-3">
                    <input type="text" id="searchInput" onkeyup="filterMarketplace()" placeholder="Search electronics, clothing..." class="bg-slate-800 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 w-64">
                </div>
            </div>

            <!-- Items Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" id="itemsGrid">
                <!-- Item Card 1 -->
                <div class="item-card bg-slate-900 border border-slate-800 rounded-2xl p-4 flex flex-col justify-between hover:border-slate-700 transition">
                    <div>
                        <div class="h-48 rounded-xl bg-slate-800 mb-4 overflow-hidden relative">
                            <img src="https://images.unsplash.com/photo-1511707171634-5f897ff02aa9?auto=format&fit=crop&w=600&q=80" alt="Smartphone" class="w-full h-full object-cover">
                            <span class="absolute top-3 right-3 bg-slate-950/80 backdrop-blur-md text-emerald-400 text-xs font-bold px-2.5 py-1 rounded-lg border border-emerald-500/20">Verified</span>
                        </div>
                        <h3 class="font-bold text-white text-lg">iPhone 13 Pro 128GB</h3>
                        <p class="text-slate-400 text-xs mt-1">Jeppestown, Johannesburg</p>
                        <p class="text-xl font-extrabold text-indigo-400 mt-3">$550.00</p>
                    </div>
                    <button onclick="initiatePurchase('iPhone 13 Pro', 550.00)" class="mt-4 w-full bg-slate-800 hover:bg-indigo-600 text-slate-200 hover:text-white font-bold py-2.5 rounded-xl transition text-sm">
                        Buy with Safe-Trade
                    </button>
                </div>

                <!-- Item Card 2 -->
                <div class="item-card bg-slate-900 border border-slate-800 rounded-2xl p-4 flex flex-col justify-between hover:border-slate-700 transition">
                    <div>
                        <div class="h-48 rounded-xl bg-slate-800 mb-4 overflow-hidden relative">
                            <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=600&q=80" alt="Headphones" class="w-full h-full object-cover">
                            <span class="absolute top-3 right-3 bg-slate-950/80 backdrop-blur-md text-indigo-400 text-xs font-bold px-2.5 py-1 rounded-lg border border-indigo-500/20">Safe Escrow</span>
                        </div>
                        <h3 class="font-bold text-white text-lg">Sony WH-1000XM4</h3>
                        <p class="text-slate-400 text-xs mt-1">Malvern, Johannesburg</p>
                        <p class="text-xl font-extrabold text-indigo-400 mt-3">$180.00</p>
                    </div>
                    <button onclick="initiatePurchase('Sony WH-1000XM4', 180.00)" class="mt-4 w-full bg-slate-800 hover:bg-indigo-600 text-slate-200 hover:text-white font-bold py-2.5 rounded-xl transition text-sm">
                        Buy with Safe-Trade
                    </button>
                </div>

                <!-- Item Card 3 -->
                <div class="item-card bg-slate-900 border border-slate-800 rounded-2xl p-4 flex flex-col justify-between hover:border-slate-700 transition">
                    <div>
                        <div class="h-48 rounded-xl bg-slate-800 mb-4 overflow-hidden relative">
                            <img src="https://images.unsplash.com/photo-1526170375885-4d8ecf77b99f?auto=format&fit=crop&w=600&q=80" alt="Camera" class="w-full h-full object-cover">
                        </div>
                        <h3 class="font-bold text-white text-lg">Vintage Film Camera</h3>
                        <p class="text-slate-400 text-xs mt-1">CBD, Johannesburg</p>
                        <p class="text-xl font-extrabold text-indigo-400 mt-3">$95.00</p>
                    </div>
                    <button onclick="initiatePurchase('Vintage Film Camera', 95.00)" class="mt-4 w-full bg-slate-800 hover:bg-indigo-600 text-slate-200 hover:text-white font-bold py-2.5 rounded-xl transition text-sm">
                        Buy with Safe-Trade
                    </button>
                </div>

                <!-- Item Card 4 -->
                <div class="item-card bg-slate-900 border border-slate-800 rounded-2xl p-4 flex flex-col justify-between hover:border-slate-700 transition">
                    <div>
                        <div class="h-48 rounded-xl bg-slate-800 mb-4 overflow-hidden relative">
                            <img src="https://images.unsplash.com/photo-1607604276583-eef5d076aa5f?auto=format&fit=crop&w=600&q=80" alt="Gaming Setup" class="w-full h-full object-cover">
                        </div>
                        <h3 class="font-bold text-white text-lg">Custom Mechanical Keyboard</h3>
                        <p class="text-slate-400 text-xs mt-1">Jeppestown, Johannesburg</p>
                        <p class="text-xl font-extrabold text-indigo-400 mt-3">$120.00</p>
                    </div>
                    <button onclick="initiatePurchase('Mechanical Keyboard', 120.00)" class="mt-4 w-full bg-slate-800 hover:bg-indigo-600 text-slate-200 hover:text-white font-bold py-2.5 rounded-xl transition text-sm">
                        Buy with Safe-Trade
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="bg-slate-950 border-t border-slate-800 py-12">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-6">
            <div class="flex items-center space-x-3">
                <div class="w-8 h-8 rounded-lg bg-indigo-600 flex items-center justify-center font-bold text-white text-sm">S</div>
                <span class="text-lg font-bold text-white">Soldit</span>
            </div>
            <p class="text-slate-500 text-xs">© 2026 Soldit Marketplace Platform. All rights reserved.</p>
            <button onclick="toggleTermsModal()" class="text-xs text-indigo-400 hover:underline">Terms & Conditions</button>
        </div>
    </footer>

    <!-- FUNCTIONAL SIGN UP / LOGIN MODAL -->
    <div id="authModal" class="fixed inset-0 bg-slate-950/85 backdrop-blur-md z-50 flex items-center justify-center hidden p-4">
        <div class="bg-slate-900 border border-slate-800 p-6 md:p-8 rounded-3xl max-w-md w-full relative shadow-2xl">
            <button onclick="toggleAuthModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white text-2xl font-bold">&times;</button>
            
            <div class="text-center mb-6">
                <div class="w-12 h-12 bg-indigo-500/10 text-indigo-400 rounded-2xl flex items-center justify-center mx-auto mb-3 border border-indigo-500/20 text-xl font-bold">
                    🚀
                </div>
                <h3 class="text-2xl font-bold text-white">Create Your Account</h3>
                <p class="text-slate-400 text-sm mt-1">Start buying, selling, and executing safe trades.</p>
            </div>

            <form id="signupForm" onsubmit="handleSignup(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Full Name</label>
                    <input type="text" id="signupName" required placeholder="John Doe" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-3 text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500">
                </div>

                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Email Address</label>
                    <input type="email" id="signupEmail" required placeholder="you@example.com" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-3 text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500">
                </div>

                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">PayPal Payout Email</label>
                    <input type="email" id="signupPaypal" required placeholder="paypal@example.com" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-3 text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500">
                </div>

                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Password</label>
                    <input type="password" id="signupPassword" required placeholder="••••••••" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-3 text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500">
                </div>

                <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-bold py-3.5 rounded-xl shadow-lg shadow-indigo-600/30 transition-all">
                    Register Account
                </button>
            </form>
        </div>
    </div>

    <!-- TERMS & CONDITIONS MODAL -->
    <div id="termsModal" class="fixed inset-0 bg-slate-950/85 backdrop-blur-md z-50 flex items-center justify-center hidden p-4">
        <div class="bg-slate-900 border border-slate-800 p-6 rounded-3xl max-w-2xl w-full max-h-[80vh] overflow-y-auto relative text-slate-300 text-sm space-y-4">
            <button onclick="toggleTermsModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white text-2xl font-bold">&times;</button>
            <h3 class="text-xl font-bold text-white">Soldit Terms and Conditions</h3>
            <p>1. Platform Venues: Soldit serves as a peer-to-peer venue connecting buyers and sellers.</p>
            <p>2. Safe Trades: In-person trades should take place in public exchange locations.</p>
            <p>3. Payments & Escrow: 3% safe-trade platform escrow fees apply to verified digital transfers.</p>
        </div>
    </div>

    <!-- JAVASCRIPT LOGIC -->
    <script>
        // Modal Toggles
        function toggleAuthModal() {
            document.getElementById('authModal').classList.toggle('hidden');
        }

        function toggleTermsModal() {
            document.getElementById('termsModal').classList.toggle('hidden');
        }

        // Handle User Sign Up
        function handleSignup(e) {
            e.preventDefault();
            const name = document.getElementById('signupName').value;
            const email = document.getElementById('signupEmail').value;
            const paypal = document.getElementById('signupPaypal').value;

            const userData = { name, email, paypal };
            localStorage.setItem('soldit_user', JSON.stringify(userData));

            updateUserUI(userData);
            toggleAuthModal();
            alert(`Welcome to Soldit, ${name}! Your account is active.`);
        }

        // Handle User Logout
        function handleLogout() {
            localStorage.removeItem('soldit_user');
            location.reload();
        }

        // Update UI when logged in
        function updateUserUI(user) {
            if (user && user.name) {
                document.getElementById('navAuthBtn').classList.add('hidden');
                document.getElementById('userProfileBtn').classList.remove('hidden');
                document.getElementById('navUserName').innerText = user.name;
            }
        }

        // Check active session on load
        window.addEventListener('DOMContentLoaded', () => {
            const savedUser = localStorage.getItem('soldit_user');
            if (savedUser) {
                updateUserUI(JSON.parse(savedUser));
            }
        });

        // Search Filter
        function filterMarketplace() {
            const query = document.getElementById('searchInput').value.toLowerCase();
            const cards = document.querySelectorAll('.item-card');
            cards.forEach(card => {
                const title = card.querySelector('h3').innerText.toLowerCase();
                if (title.includes(query)) {
                    card.style.display = 'flex';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        // Simulate PayPal Order Creation
        async function initiatePurchase(itemName, price) {
            const user = localStorage.getItem('soldit_user');
            if (!user) {
                alert('Please sign up or log in first to make a purchase!');
                toggleAuthModal();
                return;
            }

            alert(`Initiating Safe-Trade Escrow for ${itemName} ($${price}). Connecting to PayPal server...`);
        }
    </script>
</body>
</html>
